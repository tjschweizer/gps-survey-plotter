# --- survey data and anything that locates a property --------------------
# A single point from a survey pins the property to the centimetre, and git
# history is permanent. Keep all of it local.
archive/
site.local.json
*.yardproj
*.yardplan
*.swmz
*.swm2
*.zip
field_sheet.html
*_ORIGIN.txt

# Exports saved into the checkout. A world file holds absolute UTM
# coordinates, and a heightmap, points file or figure locates the lot too.
*.pgw
heightmap_*
revit_points*.csv
slope_map*.png
contours_*.png
